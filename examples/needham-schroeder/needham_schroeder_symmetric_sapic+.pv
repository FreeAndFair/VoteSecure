(* ========================================================================
   Needham-Schroeder Symmetric Protocol (Original, Broken) — ProVerif Model

   @refine needham_schroeder_symmetric_sapic+.spthy |= ProVerif
   @refine NeedhamSchroeder.cry |= ProVerifOriginalProtocol
   @design dmzimmerman Generated from SAPIC+ by GSVerif.

   ProVerif translation of Needham-Schroeder Symmetric (Original)
   Daniel M. Zimmerman, February 2025

   This file was generated by "progsverif" (GSVerif) inside the SAPIC+ tools
   Docker container, and is far more difficult to read than if Tamarin simply
   generated ProVerif output; however, Tamarin fails to generate ProVerif
   output for this theory at the present time.

   Comments indicate what structures have been translated, where it isn't
   obvious from the names.

   Nonce confirmation uses c0/c1 constant-pairing, matching the Tamarin
   models' approach.  The fixed ProVerif model uses succ() instead; see
   the header comment there for rationale.

   Note that the ReplayAttack lemma had to be commented out in the SAPIC+,
   because ProVerif can't handle it (it contains an equality before an
   implication); in ProVerif we would more naturally structure that as a
   property on a protocol phase where a session key reveal occurred (and
   having protocol phases would make the ProVerif lemmas simpler in general).
   ======================================================================== *)

type host.
type key.
type nonce.

free att:channel.

fun senc(bitstring,key):bitstring.
fun sharedkey(host):key [private].
fun unused():nonce.

event AliceSessionStarted(host,host,key).
event BobSessionStarted(host,host,key).
event Honest(host).
event IN_ALICE_2_omfs(bitstring,bitstring).
event IN_ALICE_4_Nb(bitstring,nonce).
event IN_BOB_3(bitstring).
event IN_SERVER_n(bitstring,nonce).
event OUT_ALICE_1_Na(bitstring,nonce).
event OUT_ALICE_3(bitstring).
event OUT_BOB_4_Nb(bitstring,nonce).
event OUT_SERVER_omfs(bitstring,bitstring).
event Secret(host,host,key,bitstring).
event SessionKey(host,host,key).
event SessionKeyRevealed(host,host,key).

reduc forall k:key,m:bitstring; sdec(senc(m,k),k) = m.

reduc forall x_1:bitstring,x_2:bitstring; fst((x_1,x_2)) = x_1.

reduc forall x_1:bitstring,x_2:bitstring; snd((x_1,x_2)) = x_2.

(* dmz: added this at the recommendation of ProVerif on first run *)
set preciseActions = true.

(* Lemma: Executable *)
query A:host,B:host,Ks:key,i:time,j:time,k:time,l:time;
event(Honest(A))@i && event(Honest(B))@j && event(BobSessionStarted(B,A,Ks))@k && event(AliceSessionStarted(A,B,Ks))@l.

(* Lemma: SymmetricSessionStart *)
query A:host,B:host,Ks:key,i:time,j:time,k:time,l:time,E:host,m:time;
  event(Honest(A))@i && event(Honest(B))@j && event(BobSessionStarted(B,A,Ks))@k ==>
        l < k && event(AliceSessionStarted(A,B,Ks))@l
    ||  m < k && event(SessionKeyRevealed(E,B,Ks))@m.

(* added queries by dmz; these didn't translate because they use K() in Tamarin *)

(* Lemma: SessionKeySecrecy *)
query A:host,B:host,Ks:key;
  event(Honest(A)) && event(Honest(B)) && event(SessionKey(A, B, Ks)) && attacker(Ks) ==>
  event(SessionKeyRevealed(A, B, Ks)).

(* Lemma: NoReplayWithoutKeyReveal (this one doesn't prove unless preciseActions
   are turned on) *)
query A:host,B:host,E:host,Ks:key,i:time,j:time;
  event(Honest(A)) && event(Honest(B)) && event(AliceSessionStarted(A, B, Ks)) &&
  event(BobSessionStarted(B, A, Ks))@i && event(BobSessionStarted(B, E, Ks))@j ==>
  (i = j && A = E) ||
  event(SessionKeyRevealed(A, B, Ks)).

(* Lemma: NoReplayWithoutKeyReveal (this one _does_ prove without
   preciseActions turned on) *)
query A:host,B:host,E:host,Ks:key,i:time,j:time;
  event(Honest(A)) && event(Honest(B)) && event(AliceSessionStarted(A, B, Ks)) &&
  event(BobSessionStarted(B, A, Ks))@i && event(BobSessionStarted(B, E, Ks))@j ==>
  (A = E) ||
  event(SessionKeyRevealed(A, B, Ks)).

(* Lemma: ProtocolSecrecy (this one doesn't prove unless preciseActions are
   turned on) *)
query A:host,B:host,Ks:key,s:bitstring;
  event(Honest(A)) && event(Honest(B)) && event(Secret(A, B, Ks, s)) && attacker(s) ==>
  event(SessionKeyRevealed(A, B, Ks)).

process
  new A_1:host;
  new B_1:host;
  new c0_1:bitstring;
  new c1_1:bitstring;
  out(att,A_1);
  out(att,B_1);
  out(att,c0_1);
  out(att,c1_1);
  event Honest(A_1);
  event Honest(B_1);
  !(
  (
    new secretA_1:bitstring; (* Application of the process Alice *)
    in(att,(xA_1:host,xB_1:host));
    if (xA_1 <> xB_1 && (xA_1 = A_1 || xA_1 = B_1)) then
    let Kas_1:key = sharedkey(xA_1) in
    new Na_1:nonce;
    event OUT_ALICE_1_Na((xA_1,(xB_1,Na_1)),Na_1);
    out(att,(xA_1,(xB_1,Na_1)));
    in(att,X2_1:bitstring);
    let (Na_2_1:nonce,(xB_2_1:host,(Ks_1:key,omfs_1:bitstring))) = sdec(X2_1,Kas_1) in
    if (Na_1 = Na_2_1 && xB_1 = xB_2_1) then
    event IN_ALICE_2_omfs(X2_1,omfs_1);
    event OUT_ALICE_3(omfs_1);
    out(att,omfs_1);
    in(att,X4_1:bitstring);
    let (c1_2_1:bitstring,Nb_1:nonce) = sdec(X4_1,Ks_1) in
    if c1_1 = c1_2_1 then
    event IN_ALICE_4_Nb(X4_1,Nb_1);
    let X5_1:bitstring = (c0_1,Nb_1) in
    event AliceSessionStarted(xA_1,xB_1,Ks_1);
    out(att,senc(X5_1,Ks_1));
    event Secret(xA_1,xB_1,Ks_1,secretA_1);
    out(att,senc(secretA_1,Ks_1));
    0
  ) | (
    !(
    (
      new secretB_1:bitstring; (* Application of the process Bob *)
      in(att,xB_1:host);
      if (xB_1 = A_1 || xB_1 = B_1) then
      let Kbs_1:key = sharedkey(xB_1) in
      in(att,X3_1:bitstring);
      event IN_BOB_3(X3_1);
      let (Ks_1:key,xA_1:host) = sdec(X3_1,Kbs_1) in
      if xA_1 <> xB_1 then
      new Nb_1:nonce;
      let X4_1:bitstring = senc((c1_1,Nb_1),Ks_1) in
      event OUT_BOB_4_Nb(X4_1,Nb_1);
      out(att,X4_1);
      in(att,X5_1:bitstring);
      let (c0_2_1:bitstring,Nb_2_1:nonce) = sdec(X5_1,Ks_1) in
      if (c0_1 = c0_2_1 && Nb_1 = Nb_2_1) then
      event BobSessionStarted(xB_1,xA_1,Ks_1);
      event Secret(xA_1,xB_1,Ks_1,secretB_1);
      out(att,senc(secretB_1,Ks_1));
      0
    ) | (
      !(
      in(att,(h1_1:host,(h2_1:host,n_1:nonce)));
      event IN_SERVER_n((h1_1,(h2_1,n_1)),n_1);
      if h1_1 <> h2_1 then
      let K1_1:key = sharedkey(h1_1) in
      let K2_1:key = sharedkey(h2_1) in
      new Ks_3:key;
      event SessionKey(h1_1,h2_1,Ks_3);
      let omfs_2:bitstring = senc((Ks_3,h1_1),K2_1) in
      let X2_2:bitstring = senc((n_1,(h2_1,(Ks_3,omfs_2))),K1_1) in
      event OUT_SERVER_omfs(X2_2,omfs_2);
      out(att,X2_2);
      event SessionKeyRevealed(h1_1,h2_1,Ks_3); (* Application of the process RevealSession *)
      out(att,Ks_3);
      0
      )    )
    )  )
  )
