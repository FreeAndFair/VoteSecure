// ========================================================================
// Architecture Metamodel
//
// @dependencies prelude.cfr
// ========================================================================

// A Clafer-based architecture specification for demonstrating
// architectural refinement and design choices as a means by which to
// fulfill some non-behavioral requirements.

// Clafer comes with both a generic architecture specification metamodel
// as well as an AADL metamodel.  We will use only the former here.

abstract System
  subSystems -> Subsystem *
  [ subSystems.parentSystem = this ]

abstract Subsystem
  parentSystem: System
  subSystems -> Subsystem *
  [ this in parentSystem.subSystems ]

abstract Component
  enclosingSubsystem: Subsystem

abstract Flow
  start -> SoftwareComponent
  end -> SoftwareComponent
  bus -> Bus ? // the bus that implements the flow, or
  network -> Network ? // the network that implements the flow
  [bus xor network] // components communicate either over a bus or over a network
  rate ->> integer // the maximum datarate in Kb/s that the flow demands
  [bus => (this in bus.flows)]
  [network => (this in network.flows)]

// =====================================================================
// Primitive types: SoftwareComponent, HardwareComponent
// Connectors: Channel, Bus, and Network
// Aggregate flow descriptions: SoftwareTopology
// =====================================================================

abstract HardwareComponent: Component
  software -> SoftwareComponent * // the software running on this hardware
  [software.target = this] // inverse relationship constraint
  mappable?
  [no mappable => no software]

abstract SoftwareComponent: Component
  target -> HardwareComponent  // hardware this software component is running on
  [this in target.software]  // inverse relationship constraint

abstract Channel: HardwareComponent
  [no mappable]
  capacity ->> integer // the maximum datarate in Kb/s that this channel supports
  flows -> Flow * // the flows that this channel implements
  components -> HardwareComponent * // the components the channel connects
  [components = flows.start.target ++ flows.end.target]
  [(sum flows.rate) <= capacity] // channel capacity constraint

abstract Bus: Channel
  [this in flows.bus]

abstract Network: Channel
  [this in flows.network]

abstract SoftwareTopology: Component
  flows -> Flow *
    [(!this.bus && (this.start.target = this.end.target))
      // software is located on the same ECU, and there is no bus between them
      ||
     (this.bus && (this.start.target in this.bus.components) &&
                  (this.end.target in this.bus.components))
     // components are communicating over a bus
      ||
     (this.network && (this.start.target in this.network.components) &&
                      (this.end.target in this.network.components))
     // components are communicating over a network
    ]

// =====================================================================
// The Configuration Metamodel
//
// The build system of the product line/product itself, including all
// components that may be a part of the TBOM, and features of CI, CD,
// and CV.
//
// @dependencies prelude.cfr platform.cfr environment.cfr
// =====================================================================

abstract BuildSystem
  buildTools -> BuildTool *

abstract DevSecOps
  platformTools -> PlatformTool *
  environment: Environment
  pipelineURL -> string

abstract ContinuousIntegration
  buildTools -> BuildTool *
  analysisTools -> BuildTool +

abstract ContinuousDeployment
  buildTools -> BuildTool +

abstract ContinuousVerification
  fmTools -> FormalMethodsTool *
  frameworks -> Framework *
  analysisTools -> Software +

// We provide an unconfigured instance of each core abstract clafer to
// permit the typechecker and instance generator to sanity-check our
// specification for validity and size.  Note that generating this
// unbound instance takes a significant amount of time and generates
// a ton of output.

arbitraryBuildSystem: BuildSystem

arbitraryDevSecOps: DevSecOps

arbitraryCI: DevSecOps

arbitraryCD: ContinuousDeployment

arbitraryCV: ContinuousVerification
// ========================================================================
// Environment - The development environment necessary to target
// Platform, including OS, programming, specification, testing, and
// reasoning toolchains.
//
// @dependencies prelude.cfr platform.cfr
// ========================================================================

