Xilinx_Vivado: Simulator

abstract Emulator

QEMU: Emulator

abstract HDL: Software

BSV: HDL
Chisel: HDL
SystemVerilog: HDL
Verilog: HDL
VHDL: HDL

enum SecurityTrap = Halt | Interrupt | JTAG | LED

abstract Platform
  bp -> BoardPackage
  compilers -> Compiler +
  oses -> OperatingSystem *
  simulators -> Simulator *
  emulators -> Emulator *
  hdl -> HDL *
  trap -> SecurityTrap

// We provide an unconfigured instance of each core abstract clafer to
// permit the typechecker and instance generator to sanity-check our
// specification for validity and size.  Note that generating this
// unbound instance takes a significant amount of time and generates
// a ton of output.

// arbitraryPlatform: Platform

// Here is an example platform configuration.

c: CPU
  [ isa = RV ]
bp: BoardPackage
  [ cpu = c ]
p: Platform
  [ compilers = Clang ]
  [ oses = Linux ]
  [ simulators = Verilator ]
  [ hdl = VHDL, Verilog ]
  [ trap = Halt ]
// ========================================================================
// RDE Product Line Engineering Models
// ========================================================================

// Copyright: 2025 Galois, Joe Kiniry, Free & Fair
// Author(s): Joe Kiniry
// Model type: Clafer
// Model version: 0.1
// Last modified: 2025.2.4

// TODO: Executive Summary

// Example of constraints and assertions used to reason about these
// models and their inter-relationships are also provided.  The
// natural language meaning of each proposition is adjacent to its
// formal specification.

// ========================================================================
// We start with a few placeholder concepts, which will be refined later.
// ========================================================================

// Nothing here right now.

// ========================================================================
// Here are some generic "types" of Clafers. Some types do not have
// properties, but are rather used for readability for the user.
// ========================================================================

abstract VersionInfo
  major_version -> integer
  minor_version -> integer
  [ 0 <= major_version
    0 <= minor_version ]

// ========================================================================
// Traceability
// ========================================================================

// A named element is any concept that has human-readable name(s).
abstract NamedElement
  name: string = "NO_NAME"
  url -> string = "https://localhost/tbd/"
  version: VersionInfo ?

// A traceable element is a concept that has a (persistent) URL which
// points to a particular artifact, and then an index into that
// artifact which points to a referrant.  Example referrants are
// section or table numbers in a document, or fully-resolved
// declarations in a specification or program.  In occasions where
// such a binder is unavailable, we can simply revert to using line
// numbers.
abstract TraceableElement: NamedElement
  referrant -> string
  line_no -> integer
  [ line_no >= 1 ]

nothing: TraceableElement
  [ referrant = "TBD" ]

// ========================================================================
// Programming Languages Metamodel
// ========================================================================

// A list of all of the programming languages that we regularly use
// in RDE projects, expressed as a Clafer enumeration.
enum ProgLanguage = Ada | C | CPlusPlus | Dafny | FStarProgLang | Go | Haskell | Java | Kotlin | OCaml | Rust | SPARK | Scala | Slang

// ========================================================================
// Specification Languages Metamodel
// ========================================================================

// A list of all of the specification languages that we regularly use
// in RDE projects, expressed as a Clafer enumeration.

enum SpecLanguage = ASCII | ASMLang | AlloyLang | BigGears | ClaferLang | CoqLang | CryptolLang | DOORSLang | Excel | FRETish | FStarSpecLang | IsabelleLang | LandoLang | LeanLang | PVSLang | Promela | ReqML | SALLang | SAPIC | SAPICStar | SAWScript |Spear | StateCharts | SysMLv1 | SysMLv2 | TamarinLang | UML | Word

// =====================================================================
// The Assurance Case Metamodel
//
// Note that a mechanization of the CLARISSA metamodel is also available.
// =====================================================================

// @todo To be included.

// =====================================================================
// The Product Metamodel
//
// The features of the product under development itself, including
// those that are design-time and run-time configurable, including all
// components that may be a part of an HBOM.
// =====================================================================

abstract Product
  abstract DesignTimeConfiguration
    abstract BuildSystemOptions
  abstract RuntimeConfiguration
    abstract CommandLineOptions
    abstract Preferences
    abstract ConfigurationFiles

abstract BillOfMaterials
  abstract SoftwareBillOfMaterials // SOBM
  abstract FirmwareBillOfMaterials // FBOM
  abstract HardwareBillOfMaterials // HBOM

// ========================================================================
// Refinements Metamodel
//
// @dependencies prelude.cfr specifications.cfr
// ========================================================================

// Refinements between models either do not exist yet, are partially
// specified, or are complete.  The rigor of any refinement is also
// denoted.  The RDE Refinements lecture explains the meaning of these
// terms.

enum RefinementStatus = None | Partial | Complete

enum RefinementRigor = Informal | SemiFormal | Formal

// Since refinements are from an abstraction to one or more
// concretizations/refinements, the `to` component is a set of specs.

abstract Refinement
  RefinementStatus
  RefinementRigor
  from -> Spec 1
  to -> Spec +

// ========================================================================
// Requirements Metamodel
//
// @dependencies prelude.cfr specifications.cfr
// ========================================================================

// Each Requirement feature has an id and descriptive text.  The
// RichRequirement feature also has additional metadata derived from
// the SysML metamodel for Requirements.

abstract Requirement: TraceableElement
  id -> string
  text -> string

// RichRequirement is a subclafer of Requirement, thus inherits all
// of its parts.
abstract RichRequirement: Requirement
  priority: integer
  derived -> Requirement
  derivedFrom -> Requirement
  master -> Requirement
  mechanizable ?
  mechanized ?
  refinedBy -> TraceableElement
  satisfiedBy -> TraceableElement
  validatedBy -> TraceableElement
  verifiedBy -> TraceableElement
  [ 0 <= priority ]

noRequirement: RichRequirement

// Assertions written on `RichRequirement`'s components is what
// permits us to reason about requirements.  In particular, we can
// trace requirement refinements (`refinedBy`), prioritize requirement
// formalizations (by defining measures over the `priority`
// component), denote what requirements are `mechanizable`, tracking
// whether or not a requirement has been `mechanized` yet,
// demonstrating that requirements are valid (`validatedBy`), and
// traceability to the assurance case (`satisfiedBy` and
// `verifiedBy`).  Note that the generic `tracedTo` component is meant
// to aggregate all traceable elements across adjacent components,
// thus its meaning is denoted as a union of the other elements'
// values.

// Next, we state in which languages one is permitted to write RDE
// informal, semi-formal, and formal requirements.

abstract InformalRequirement: RichRequirement
  specs -> Spec +
  [ all s: specs | s.language in ASCII, Word, Excel, DOORSLang ]

abstract SemiformalRequirement: RichRequirement
  specs -> Spec
  [ all s: specs | s.language in ReqML, SysMLv1, SysMLv2, DOORSLang ]

abstract FormalRequirement: RichRequirement
  specs -> Spec
  [ all s: specs | s.language in
      SysMLv2, FRETish, Spear, PVSLang, CoqLang, LeanLang,
      IsabelleLang, TamarinLang, SAPIC, SAPICStar ]

// A set of requirements is a set of traditional requirements
// engineering requirements coupled to sets of informal, semi-formal,
// and formal requirements. Note that the traceability between
// traditional requirements and RDE requirements is found in
// `RichRequirements.refinedBy`.

abstract Requirements: TraceableElement
  requirements -> Requirement
  informal -> InformalRequirement
  semiFormal -> SemiformalRequirement
  formal -> FormalRequirement

// Here are some example requirements to check the validity of the
// metamodel.

lsp: Spec
  [ language = ASCII ]
rsp: Spec
  [ language = SysMLv2 ]
fsp: Spec
  [ language = FRETish ]
ir: InformalRequirement
  [ priority = 1 ]
  [ specs = lsp ]
  [ id = "ValidityChecker" ]
  [ text = "A single concrete InformalRequirement used to check model validity." ]
sr: SemiformalRequirement
  [ specs = rsp ]
fr: FormalRequirement
  [ specs = fsp ]
rs: Requirements
  [ requirements = noRequirement ]
  [ informal = ir ]
  [ semiFormal = sr ]
  [ formal = fr ]
// ========================================================================
// Specification Metamodel
//
// @dependencies prelude.cfr
// ========================================================================

// A specification is a traceable element that is written in a
// specification language.

abstract Spec: TraceableElement
  language -> SpecLanguage

// ========================================================================
// A Clafer-based system specification, tying together all kinds of
// specifications.
// ========================================================================

abstract Specs
  specs -> Spec +

abstract DomainModelSpecs: Specs
  [ all s: specs | s.language in LandoLang, SysMLv1, SysMLv2, AlloyLang, UML ]

abstract InformalRequirementsSpecs: Specs
  [ all s:specs | s.language in
      ASCII, Word, Excel, SysMLv1, SysMLv2, DOORSLang, UML ]

abstract SemiformalRequirementsSpecs: Specs
  [ all s:specs | s.language in ReqML, LandoLang ]

abstract FormalRequirementsSpecs: Specs
  [ all s:specs | s.language in FRETish, Spear ]

abstract FeatureModelingSpecs: Specs
  [ all s:specs | s.language in ClaferLang, BigGears, SysMLv1, SysMLv2, UML ]

abstract CryptoAlgSpec: Specs
  [ all s:specs | s.language in CryptolLang, FStarSpecLang ]

abstract CryptoProtoSpec: Specs
  [ all s:specs | s.language in CryptolLang, TamarinLang, SAPIC, SAPICStar ]

abstract NetworkArchSpec: Specs
  [ all s:specs | s.language in SysMLv1, SysMLv2 ]

abstract NetworkProtoSpec: Specs
  [ all s:specs | s.language in SysMLv1, SysMLv2 ]

abstract StateMachineSpec: Specs
  [ all s:specs | s.language in
      SALLang, Promela, CryptolLang, SysMLv1, SysMLv2, UML, StateCharts, ASMLang ]

// =====================================================================
// The top-level System Specification
// =====================================================================

abstract SystemSpecification
  domainEngineeringSpecs: DomainModelSpecs
  requirementsSpecs
    informalRequirementsSpecs -> InformalRequirementsSpecs *
    semiformalRequirementsSpecs -> SemiformalRequirementsSpecs *
    formalRequirementsSpecs -> formalRequirementsSpecs *
  featureModelSpecs -> FeatureModelingSpecs *
  platformSpec: Platform
  environmentSpec: Environment
  productSpec: Product
  billOfMaterials: BillOfMaterials
  // These metamodels are not yet moved into this prelude.
  // deploymentSpecs ->> Spec
  // devSecOpsSpecs ->> Spec
  // assuranceCaseSpecs ->> Spec
  architectureSpec: System
  behavioralSpecs
    // stateMachineSpecs -> StateMachineSpec *
    // networkProtoSpecs -> NetworkProtoSpec *
  nonBehavioralSpecs
    securitySpecs
      // threatModelSpec ->> Spec
      cryptoAlgSpecs -> CryptoAlgSpec *
      cryptoProtoSpecs -> CryptoProtoSpec *
      // performanceSpecs ->> Spec
      // throughputSpecs ->> Spec
  refinements -> Refinement *
// ========================================================================
// Needham-Schroeder Product Line Engineering Models
// ========================================================================

// Copyright: 2025 Free & Fair
// Author(s): Joe Kiniry
// Model type: Clafer
// Model version: 1.0
// Last modified: 2025.2.1

// This set of models are specifications of several fundamental
// product line engineering aspects of this Needham-Schroeder (NS,
// henceforth) example.

// This model depends upon the RDE prelude which defines the abstract
// clafers (type structure) that describes various sub-domains of
// modeling. That abstract model is concretized for this particular
// example.

// Example of constraints and assertions used to reason about these
// models and their inter-relationships are also provided.  The
// natural language meaning of each proposition is adjacent to its
// formal specification.

// The product line engineering models included herein are:
//  - [ ] the semi-formal and formal correctness properties of NS
//  - [ ] the security requirements of NS
//  - [ ] the high-level architecture of NS

// import prelude.cfr

// ========================================================================
// Needham-Schroeder Specifications
// ========================================================================

LandoSpec: Spec
  [ language = LandoLang ]
  [ referrant = "NeedhamSchroederSymmetric" ]
  [ line_no = 8 ]
  [ url = "NeedhamSchroeder.lando" ]

CryptolSpec: Spec
  [ language = CryptolLang ]
  [ referrant = "NeedhamSchroeder" ]
  [ line_no = 1 ]
  [ url = "NeedhamSchroeder.cry" ]

TamarinSpec: Spec
  [ language = TamarinLang ]
  [ referrant = "nss_rules_fixed" ]
  [ line_no = 1 ]
  [ url = "needham_schroeder_fixed_symmetric_rules.spthy" ]

SysMLSpec: Spec
  [ language = SysMLv2 ]
  [ referrant = "SimpleCryptography" ]
  [ line_no = 1 ]
  [ url = "NeedhamSchroeder.sysml" ]

SAPICSpec: Spec
  [ language = SAPICStar ]
  [ referrant = "nss_sapic_fixed" ]
  [ line_no = 1 ]
  [ url = "needham_schroeder_fixed_symmetric_sapic+.spthy" ]

// ========================================================================
// Needham-Schroeder Requirements and their Refinements
// ========================================================================

abstract NeedhamSchroederSecurityRequirement: FormalRequirement
  [ specs = TamarinSpec ]

SymmetricEncryptionAssumption: TraceableElement
  [ url = "needham_schroeder_fixed_symmetric_rules.spthy#symmetric-encryption" ]

Symmetric: NeedhamSchroederSecurityRequirement
  [ id = "Symmetric" ]
  [ text = "The protocol must use a symmetric cipher." ]
  [ satisfiedBy =  SymmetricEncryptionAssumption ]

TwoPartiesNamesTamarin: TraceableElement
  [ url = "needham_schroeder_fixed_symmetric_rules.spthy#A", "needham_schroeder_fixed_symmetric_rules.spthy#B" ]

TwoPartiesNamesSysML: TraceableElement
  [ url = "NeedhamSchroederFixedSymmetricProtocol.Alice", "NeedhamSchroederFixedSymmetricProtocol.Bob" ]

TwoParty: NeedhamSchroederSecurityRequirement
  [ id = "Two Party" ]
  [ text = "The protocol must establish a session key between two parties." ]
  [ satisfiedBy = TwoPartiesNamesTamarin, TwoPartiesNamesSysML ]

ProtocolSecrecyLemma: TraceableElement
  [ url = "needham_schroeder_fixed_symmetric_rules.spthy#ProtocolSecrecy" ]

SendASecretRule: TraceableElement
  [ url = "needham_schroeder_fixed_symmetric_rules.spthy#SendASecret" ]

SessionKeyUse: NeedhamSchroederSecurityRequirement
  [ id = "Session Key Use" ]
  [ text = "The session key established by the protocol must be usable for later secure communications between the two parties who established the key." ]
  [ satisfiedBy = ProtocolSecrecyLemma, SendASecretRule ]

Restriction1: TraceableElement
  [ url = "needham_schroeder_fixed_symmetric_rules.spthy#SingleSharedKeyPerPrincipal" ]

SingleSharedKeyPerUser: NeedhamSchroederSecurityRequirement
  [ id = "Single Shared Key Per Principal" ]
  [ text = "Any participant in the protocol only generates a single key." ]
  [ satisfiedBy = Restriction1 ]

Lemma1: TraceableElement
  [ url = "needham_schroeder_fixed_symmetric_rules.spthy#Executable" ]

Executable: NeedhamSchroederSecurityRequirement
  [ id = "Executable" ]
  [ text = "The protocol always terminates so long as messages are not lost." ]
  [ satisfiedBy = Lemma1 ]

Lemma2: TraceableElement
  [ url = "needham_schroeder_fixed_symmetric_rules.spthy#SymmetricSessionStart" ]

ConfirmationTwoWay: NeedhamSchroederSecurityRequirement
  [ id = "Confirmation Two Way" ]
  [ text = "If one participant believes that the protocol concluded successfully, both do." ]
  [ satisfiedBy = Lemma2 ]

Lemma3: TraceableElement
  [ url = "needham_schroeder_fixed_symmetric_rules.spthy#SessionKeySecrecy" ]

SessionKeySecrecy: NeedhamSchroederSecurityRequirement
  [ id = "Secrecy of Session Key" ]
  [ text = "The session key is private to the protocol participants." ]
  [ satisfiedBy = Lemma3 ]

SharedKeysRestriction: TraceableElement
  [ url = "needham_schroeder_fixed_symmetric_rules.spthy#SharedKeysRemainSecret" ]

SecrecyOfSharedKeys: NeedhamSchroederSecurityRequirement
  [ id = "Secrecy of Shared Keys" ]
  [ text = "The key shared between each protocol participant and the trusted server is private to them." ]
  [ satisfiedBy = SharedKeysRestriction ]

NoReplayAttackLemma: TraceableElement
  [ url = "needham_schroeder_fixed_symmetric_rules.spthy#NoReplayAttack" ]

SingleSessionKeyPerPair: NeedhamSchroederSecurityRequirement
  [ id = "Single Session Key Per Pair" ]
  [ text = "Any pair of participants that mutually generate a session key using the protocol know the same session key." ]
  [ satisfiedBy = NoReplayAttackLemma ]

NeedhamSchroederWikipediaPage: Spec
  [ url = "https://en.wikipedia.org/wiki/Needham%E2%80%93Schroeder_protocol" ]
  [ language = ASCII ]

NeedhamSchroederInformalRequirementsSpec: InformalRequirement
  [ specs = NeedhamSchroederWikipediaPage ]
  [ refinedBy = NeedhamSchroederSemiformalRequirementsSpec ]

NeedhamSchroederSemiformalRequirementsSpec: SemiformalRequirement
  [ specs =  LandoSpec, SysMLSpec ]
  [ refinedBy = NeedhamSchroederFormalRequirementsSpec ]

NeedhamSchroederFormalRequirementsSpec: FormalRequirement
  [ specs =  TamarinSpec, CryptolSpec, SAPICSpec ]

NeedhamSchroederInformalRequirements: Requirements
  [ requirements = Symmetric, TwoParty, SessionKeyUse,
      SingleSharedKeyPerUser, SingleSessionKeyPerPair,
      Executable, ConfirmationTwoWay,
      SecrecyOfSharedKeys, SessionKeySecrecy ]
  [ informal = NeedhamSchroederInformalRequirementsSpec ]
  [ formal = NeedhamSchroederFormalRequirementsSpec ]

// ========================================================================
// Refinements specific to this Needham-Schroeder example.
// ========================================================================

CONOPS_to_Lando: Refinement
  Partial
  Informal
  [ from = NeedhamSchroederWikipediaPage ]
  [ to = LandoSpec, SysMLSpec ]

CONOPS_to_SysML: Refinement
  Partial
  SemiFormal
  [ from = NeedhamSchroederWikipediaPage ]
  [ to = SysMLSpec ]

Lando_to_SysML
  Partial
  SemiFormal
  [ from = LandoSpec ]
  [ to = SysMLSpec ]

SysML_to_Cryptol
  Partial
  Formal
  [ from = SysMLSpec ]
  [ to = CryptolSpec ]

SysML_to_Protocol
  Partial
  Formal
  [ from = SysMLSpec ]
  [ to = TamarinSpec, SAPICSpec ]

Cryptol_to_Protocol
  Complete
  Formal
  [ from = CryptolSpec ]
  [ to = TamarinSpec, SAPICSpec ]

// ========================================================================
// Classical Feature Model
// ========================================================================

// Our NS pedagogical example only has two variants: the
// originally-published insecure protocol, and the corrected, secure
// version of the protocol.

NeedhamSchroederExample: TraceableElement
  Insecure: TraceableElement
    [ url = "needham_schroeder_symmetric_rules.spthy",
            "needham_schroeder_symmetric_sapic+.spthy",
            "needham_schroeder_symmetric_sapic+.pv" ]
  Secure: TraceableElement
    [ url = "needham_schroeder_fixed_symmetric_rules.spthy",
            "needham_schroeder_fixed_symmetric_sapic+.spthy",
            "needham_schroeder_fixed_symmetric_sapic+.pv" ]

// ========================================================================
// Architecture Metamodel
// ========================================================================

// A Clafer-based architecture specification for demonstrating
// architectural refinement and design choices as a means by which to
// fulfill some non-behavioral requirements.

// TODO Joe Kiniry

// ========================================================================
// The top-level System Specification, which ties all PLE models together.
// ========================================================================

NeedhamSchroederDemonstrationSystem: System
//  [ domainEngineeringSpecs = LandoSpec ]
//  [ requirementsSpecs = ... ]
//    [ informalRequirementsSpecs = NeedhamSchroederRequirements ]
//  [ featurePLeSpecs = ... ]
//  behavioralSpecs
//    [ stateMachineSpecs = CryptolSpec, SAPICSpec ]
//    [ networkProtocolSpecs = TamarinSpec, SysMLSpec, SAPICSpec ]
//  nonBehavioralSpecs
//  securitySpecs
//    threatModelSpec
//    [ cryptographicAlgorithmsSpecs = CryptolSpec ]
//    [ cryptographicProtocolSpecs = TamarinSpec, SAPICSpec ]
//  performanceSpecs
//    latencySpecs
//    throughputSpecs
// architecturePLESpec
